<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Atc.Aspire.Hosting.Azure.IoTHub</PackageId>
    <PackageTags>aspire;hosting;azure;iot;iothub;eventhubs</PackageTags>
    <Description>An Aspire hosting integration that forwards the device lifecycle events, twin change events and telemetry of a real Azure IoT Hub to local Event Hubs, e.g. the Event Hubs emulator.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.EventHubs" Version="13.6.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.EventHubs" Version="5.12.2" />
    <PackageReference Include="Azure.ResourceManager.IotHub" Version="1.1.1" />
    <PackageReference Include="Azure.ResourceManager.ResourceGraph" Version="1.1.1" />
    <PackageReference Include="Microsoft.Azure.Amqp" Version="2.7.4" />
  </ItemGroup>

</Project>