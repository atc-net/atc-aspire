<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for runtime: embeds .kusto files in the assembly -->
    <EmbeddedResource Include="**/*.kusto" />

    <!-- Required for compile-time validation: allows the analyzer to verify .kusto files exist -->
    <AdditionalFiles Include="**/*.kusto" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\Atc.Aspire.Azure.Kusto\Atc.Aspire.Azure.Kusto.csproj" />
    <ProjectReference Include="..\..\src\Atc.Aspire.Hosting.Azure.Kusto\Atc.Aspire.Hosting.Azure.Kusto.csproj" />
    <ProjectReference Include="..\Atc.Aspire.Hosting.Azure.Kusto.ServiceDefaults\Atc.Aspire.Hosting.Azure.Kusto.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageReference Include="Atc.Rest.MinimalApi" Version="2.0.41" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
  </ItemGroup>

</Project>
